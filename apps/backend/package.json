{
  "name": "@ila/backend",
  "description": "ILA backend API (Express + Better Auth + Drizzle/Postgres)",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "compile": "tsc --noEmit",
    "test": "bun test",
    "lint": "tsc --noEmit",
    "auth:generate": "better-auth generate --config src/lib/auth.ts --output src/db/auth.schema.ts -y",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "1.0.29",
    "@ila/shared": "workspace:*",
    "ai": "5.0.106",
    "better-auth": "^1.2.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "mammoth": "1.10.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "unpdf": "1.6.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.2.9",
    "@ila/typescript-config": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
