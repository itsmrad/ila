# ---------------------------------------------------------------------------
# ILA backend environment
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000
# Comma-separated list of the log level: fatal|error|warn|info|debug|trace
LOG_LEVEL=debug

# Public base URL of THIS backend (used by Better Auth for callbacks/cookies)
BETTER_AUTH_URL=http://localhost:4000
# 32+ char secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-base64-32-min-32-chars

# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ila

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated trusted browser origins (web app, etc.)
# e.g. http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000

# Exact Chrome extension origin permitted to call the backend API.
# EXTENSION_ORIGIN=chrome-extension://<EXTENSION_ID>
EXTENSION_ORIGIN=

# Where the login page redirects after auth. Chrome identity uses this exact URI.
# EXTENSION_REDIRECT_URL=https://<EXTENSION_ID>.chromiumapp.org/
EXTENSION_REDIRECT_URL=

# URL of the production frontend website (where the real login lives).
WEB_APP_URL=http://localhost:3000

# Comma-separated CIDRs for reverse proxies that set X-Forwarded-For.
# Leave empty when the backend is reached directly.
TRUSTED_PROXY_CIDRS=

# ---------------------------------------------------------------------------
# AI provider — any OpenAI-compatible chat/completions endpoint.
# The key lives ONLY here; the extension never sees it. Requests flow:
#   extension -> (bearer session) backend -> (AI_API_KEY) provider
# ---------------------------------------------------------------------------

# Base URL including the version path.
#   OpenRouter : https://openrouter.ai/api/v1
#   OpenAI     : https://api.openai.com/v1
#   Groq       : https://api.groq.com/openai/v1
AI_BASE_URL=https://openrouter.ai/api/v1

# Secret API key for the endpoint above (e.g. your OpenRouter key).
# When empty, the chat API responds 503 instead of starting the server broken.
AI_API_KEY=

# Label used for the provider in AI SDK model ids and logs.
AI_PROVIDER_NAME=openrouter

# Default model id sent to the provider.
AI_MODEL=openai/gpt-4o-mini

# Comma-separated allowlist of model ids a client is permitted to request.
# Must contain AI_MODEL. Leave empty to allow only AI_MODEL.
AI_ALLOWED_MODELS=

# Generation + transport guards.
AI_MAX_OUTPUT_TOKENS=2048
AI_TEMPERATURE=0.7
AI_REQUEST_TIMEOUT_MS=120000

# Per-user rate limit for POST /api/chat (database-backed fixed window).
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_RATE_LIMIT_MAX=20

# ---------------------------------------------------------------------------
# User secrets (BYOK provider keys)
# ---------------------------------------------------------------------------
# Master key used to encrypt user-supplied LLM API keys at rest (AES-256-GCM).
# 32 bytes, base64: openssl rand -base64 32
# While empty, POST/GET/DELETE /api/keys/llm respond 503 and the extension shows
# BYOK as unavailable. Rotating this value makes existing stored keys unreadable.
SECRETS_ENCRYPTION_KEY=
