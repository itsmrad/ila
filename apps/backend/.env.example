# ---------------------------------------------------------------------------
# ILA backend environment
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3005
# Comma-separated list of the log level: fatal|error|warn|info|debug|trace
LOG_LEVEL=debug

# Public base URL of THIS backend (used by Better Auth for callbacks/cookies)
BETTER_AUTH_URL=http://localhost:3005
# 32+ char secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-base64-32-min-32-chars

# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ila

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated trusted origins (frontend web app, extension id, etc.)
# e.g. http://localhost:3000,chrome-extension://<EXTENSION_ID>
TRUSTED_ORIGINS=http://localhost:3000

# Where the login page redirects back to after auth (the extension callback page).
# e.g. https://<EXTENSION_ID>.chromiumapp.org/ or a deep link.
EXTENSION_REDIRECT_URL=http://localhost:3000/auth/callback

# URL of the production frontend website (where the real login lives).
WEB_APP_URL=http://localhost:3000
