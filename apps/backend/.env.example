# ---------------------------------------------------------------------------
# ILA backend environment
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000
# Comma-separated list of the log level: fatal|error|warn|info|debug|trace
LOG_LEVEL=debug

# Public base URL of THIS backend (used by Better Auth for callbacks/cookies)
BETTER_AUTH_URL=http://localhost:4000
# 32+ char secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-base64-32-min-32-chars

# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ila

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated trusted browser origins (web app, etc.)
# e.g. http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000

# Exact Chrome extension origin permitted to call the backend API.
# EXTENSION_ORIGIN=chrome-extension://<EXTENSION_ID>
EXTENSION_ORIGIN=

# Where the login page redirects after auth. Chrome identity uses this exact URI.
# EXTENSION_REDIRECT_URL=https://<EXTENSION_ID>.chromiumapp.org/
EXTENSION_REDIRECT_URL=

# URL of the production frontend website (where the real login lives).
WEB_APP_URL=http://localhost:3000

# Comma-separated CIDRs for reverse proxies that set X-Forwarded-For.
# Leave empty when the backend is reached directly.
TRUSTED_PROXY_CIDRS=
