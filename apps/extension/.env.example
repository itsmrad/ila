# Base URL of the ILA backend API (Better Auth + chat endpoints live here).
#
# This value is used twice at build time:
#   1. the runtime API client (`lib/config.ts`)
#   2. the manifest's `host_permissions` (`wxt.config.ts`)
#
# It must be a real environment variable, not just a line in this file, so both
# stay in sync:
#
#   VITE_BACKEND_URL=https://api.example.com bun run build
#
# A production build (`wxt build` / `bun run build`) FAILS when it is unset, so a
# release can never ship with localhost host permissions. Development
# (`bun run extension:dev`) falls back to http://localhost:4000.
VITE_BACKEND_URL=http://localhost:4000
