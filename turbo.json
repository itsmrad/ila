{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**", "dist/**", ".wxt/**", ".next/**"],
      "env": ["NODE_ENV", "VITE_BACKEND_URL", "WXT_PUBLIC_BACKEND_URL", "NEXT_PUBLIC_BACKEND_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "compile": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    }
  }
}
